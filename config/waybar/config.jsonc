{
    "layer": "top",
    "position": "top",
    "height": 34,
    "exclusive": true,
    "passthrough": false,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "margin-bottom": 0,
    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/hardware",
        "group/system",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "󰲠",
            "2": "󰲢",
            "3": "󰲤",
            "4": "󰲦",
            "5": "󰲨",
            "6": "󰲪",
            "7": "󰲬",
            "8": "󰲮",
            "9": "󰲰",
            "urgent": "󰀨",
            "focused": "󰮯",
            "default": "󰄰"
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 36,
        "separate-outputs": true
    },

    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M:%S}",
        "format-alt": "󰸗 {:%d/%m/%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory"
        ]
    },

    "cpu": {
        "format": "<span color='#7aa2f7'></span> {usage}%",
        "interval": 2,
        "tooltip": true,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "<span color='#bb9af7'></span> {percentage}%",
        "interval": 2,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB",
        "on-click": "kitty -e btop"
    },

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "network",
            "battery"
        ]
    },

    "pulseaudio": {
        "format": "<span color='#e0af68'>{icon}</span> {volume}%",
        "format-muted": "<span color='#565f89'>󰝟</span> Mute",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "max-volume": 150,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "network": {
        "format-wifi": "<span color='#7dcfff'></span> {signalStrength}%",
        "format-ethernet": "<span color='#7dcfff'>󰌘</span> {ipaddr}",
        "format-disconnected": "<span color='#f7768e'>󰤮</span> Off",
        "tooltip-format-wifi": "SSID: {essid}\nIP: {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "<span color='#9ece6a'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#2ac3de'>󱐋</span> {capacity}%",
        "format-plugged": "<span color='#7aa2f7'></span> {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout || hyprctl dispatch exit"
    }
}

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "type": "kitty-direct",
        "width": 32,
        "height": 16,
        "preserveAspectRatio": true,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰄾 "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS",
            "keyColor": "cyan"
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "magenta"
        },
        {
            "type": "battery",
            "key": "Battery",
            "keyColor": "red"
        },
        "break",
        "colors"
    ]
}
